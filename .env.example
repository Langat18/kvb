APP_URL=http://localhost
APP_ENV=local

# In Docker, DB_HOST must match the db service/container name
DB_HOST=db
DB_PORT=5432
DB_NAME=vet_event_attendance
DB_USER=vetadmin
DB_PASSWORD=password

# Email (sent via Brevo's HTTP API — see src/VetBoard/Mailer.php)
BREVO_API_KEY=
MAIL_FROM_NAME="Kenya Veterinary Board"
MAIL_FROM_ADDRESS=no-reply@kenyavetboard.or.ke
